# Copy this file to .env before the first start when custom values are needed.
LEXO_IMAGE=lexo-server
LEXO_VERSION=local
LEXO_BIND_ADDRESS=127.0.0.1
LEXO_PORT=8080
LEXO_JAVA_OPTS=-Xms512m -Xmx2g -Dfile.encoding=UTF-8

GRAPHDB_IMAGE=ontotext/graphdb:10.8.14
GRAPHDB_BIND_ADDRESS=127.0.0.1
GRAPHDB_PORT=7200
