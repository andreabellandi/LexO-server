	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:label xml:lang="en">ILI definition</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#script">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#Form"/>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<rdfs:label xml:lang="en">script</rdfs:label>
	<rdfs:comment xml:lang="en">The script as a 4 letter ISO 15924 code</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#note">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
	<rdfs:label xml:lang="en">note</rdfs:label>
	<rdfs:comment xml:lang="en">Any extra notes made by a WordNet creator</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#SynsetRelType">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:label xml:lang="en">synset relation type</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#SenseRelType">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:label xml:lang="en">sense relation type</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#agent">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">agent</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is typically the one/that who/which does the action denoted by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_agent"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#also">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">also</rdfs:label>
	<rdfs:comment xml:lang="en">a word having a loose semantic relation to another word</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetと相手synsetとの間に何らかの関連がある</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#also"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#antonym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">antonym</rdfs:label>
	<rdfs:comment xml:lang="en">An opposite and inherently incompatible word</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該語義やsynsetの意味や程度が反対または対の関係となっている語義やsynset</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#antonym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#attribute">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">attribute</rdfs:label>
	<rdfs:comment xml:lang="en">an abstraction belonging to or characteristic of an entity</rdfs:comment>
	<rdfs:comment xml:lang="ja">(a=形容詞のsynsetから見て)当該synsetが相手synsetという属性を表す際に使われる
(n=名詞のsynsetから見て)当該synsetという属性を表す際に相手synsetを使う</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#attribute"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#be_in_state">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">be in state</rdfs:label>
	<rdfs:comment xml:lang="en">X is qualified by Y</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#state_of"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#causes">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">causes</rdfs:label>
	<rdfs:comment xml:lang="en">Concept A is an entity that produces an effect or is responsible for events or
results of Concept B.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetを行うと、相手synsetを引き起こす</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#is_caused_by"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#classified_by">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">classified by</rdfs:label>
	<rdfs:comment xml:lang="en">Concept B is modified by classifier A when it is counted.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#classifies"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#classifies">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">classifies</rdfs:label>
	<rdfs:comment xml:lang="en">A concept A used when counting concept B</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#classified_by"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_agent_instrument">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-agent instrument</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the instrument used by a given concept in an action.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_instrument_agent"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_agent_patient">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-agent patient</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the patient undergoing an action carried out by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_patient_agent"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_agent_result">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-agent result</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the result of an action taken by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_result_agent"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_instrument_agent">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-instrument agent</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which carries out an action by using a given concept as an instrument.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_agent_instrument"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_instrument_patient">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-instrument patient</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which undergoes an action with the use of a given concept as an instrument.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_patient_instrument"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_instrument_result">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-instrument result</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the result of an action using an instrument of a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_result_instrument"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_patient_agent">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-patient agent</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which carries out an action a given concept undergoing.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_agent_patient"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_patient_instrument">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-patient instrument</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is used as an instrument in an action a given concept undergoes.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_instrument_patient"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_result_agent">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-result agent</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which takes an action resulting in a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_agent_result"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_result_instrument">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-result instrument</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is used as an instrument in an action resulting in a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_instrument_result"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#co_role">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">co-role</rdfs:label>
	<rdfs:comment xml:lang="en">A concept undergoes an action in which a given concept is involved.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#co_role"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#derivation">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">derivation</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is a derivationally related form of a given concept.</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#direction">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">direction</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the direction of the action or event expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_direction"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#domain_region">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">domain region</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is a geographical / cultural domain pointer of a given concept.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetの地域に属するものである</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_domain_region"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#domain_topic">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">domain topic</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the scientific category pointer of a given concept.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetのカテゴリに属する</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_domain_topic"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#exemplifies">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">exemplifies</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the example of a given concept.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetの用法が相手synsetの領域に限られる</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#is_exemplified_by"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#entails">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">entails</rdfs:label>
	<rdfs:comment xml:lang="en">impose, involve, or imply as a necessary accompaniment or result</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetを行う場合、必ず相手synsetも行っている</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#is_entailed_by"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#eq_synonym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">eq synonym</rdfs:label>
	<rdfs:comment xml:lang="en">X and Y are equivalent concepts but their nature requires that they remain separate (e.g. Exemplifies)</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#eq_synonym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_domain_region">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">has domain region</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the term in the geographical / cultural domain of a given concept.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetの属する地域である</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#domain_region"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_domain_topic">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">has domain topic</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is a term in the scientific category of a given concept.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetが属するカテゴリである</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#domain_topic"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#is_exemplified_by">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">is exemplified by</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the type of a given concept.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetの領域が相手synsetの用法を規定する</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#exemplifies"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#metaphor">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">metaphor</rdfs:label>
	<rdfs:comment xml:lang="en">a relation between two senses, where the first sense is a metaphorical extension of the second sense</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_metaphor"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_metaphor">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">has metaphor</rdfs:label>
	<rdfs:comment xml:lang="en">a relation between two senses, where the second sense is a metaphorical extension of the first sense</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#metaphor"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#metonym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">metonym</rdfs:label>
	<rdfs:comment xml:lang="en">a relation between two senses, where the first sense is a metonymical extension of the second sense</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_metonym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_metonym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">has metonym</rdfs:label>
	<rdfs:comment xml:lang="en">a relation between two senses, where the second sense is a metonymical extension of the first sense</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#metonym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#holo_location">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">holonym location</rdfs:label>
	<rdfs:comment xml:lang="en">Y is a place located in X</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#mero_location"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#holo_member">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">holonym member</rdfs:label>
	<rdfs:comment xml:lang="en">Concept B is a member of Concept A</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetという構成員によって構成される</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#mero_member"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#holo_part">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">holonym part</rdfs:label>
	<rdfs:comment xml:lang="en">Concept B is the whole where Concept A is a part</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが部分として相手synsetを構成する</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#mero_part"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#holo_portion">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">holonym portion</rdfs:label>
	<rdfs:comment xml:lang="en">Y is an amount/piece/portion of X</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#mero_portion"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#holo_substance">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">holonym substance</rdfs:label>
	<rdfs:comment xml:lang="en">Concept-B is a substance of Concept-A</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetを構成する物質or材料である</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#mero_substance"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#holonym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">holonym</rdfs:label>
	<rdfs:comment xml:lang="en">X makes up a part of Y</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetがsynsetを構成する</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#meronym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#hypernym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">hypernym</rdfs:label>
	<rdfs:comment xml:lang="en">a word that is more general than a given word</rdfs:comment>
	<rdfs:comment xml:lang="pl">Relacja łącząca znaczenie z drugim, ogólniejszym, niż to pierwsze, ale
należącym do tej samej części mowy, co ono</rdfs:comment>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#hyponym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#hyponym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">hyponym</rdfs:label>
	<rdfs:comment xml:lang="en">a word that is more specific than a given word</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetを包含する</rdfs:comment>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#hypernym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#in_manner">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">in manner</rdfs:label>
	<rdfs:comment xml:lang="en">Y qualifies the manner in which an action or event expressed by X takes place</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#manner_of"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#instance_hypernym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">instance hypernym</rdfs:label>
	<rdfs:comment xml:lang="en">the type of an instance</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetは相手synsetを事例として持つ</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#instance_hyponym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#instance_hyponym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">instance hyponym</rdfs:label>
	<rdfs:comment xml:lang="en">an occurrence of something</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetは相手synsetの事例である</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#instance_hypernym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#instrument">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">instrument</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the instrument necessary for the action or event expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_instrument"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action or event a given concept typically involved in.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#role"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_agent">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved agent</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action done by an agent expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#agent"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_direction">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved direction</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action with the direction expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#direction"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_instrument">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved instrument</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is typically the action with the instrument expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#instrument"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_location">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved location</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the event happening in a place expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#location"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_patient">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved patient</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action that the patient expressed by a given concept undergoing.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#patient"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_result">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved result</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action or event with a result of a given concept comes into existence.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#result"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_source_direction">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved source direction</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action beginning from a place of a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#source_direction"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#involved_target_direction">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">involved target direction</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the action or event leading to a place expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#target_direction"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#is_caused_by">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">is caused by</rdfs:label>
	<rdfs:comment xml:lang="en">X comes about because of Y</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#causes"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#is_entailed_by">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">is entailed by</rdfs:label>
	<rdfs:comment xml:lang="en">Opposite of entails</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#entails"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#is_subevent_of">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">is subevent of</rdfs:label>
	<rdfs:comment xml:lang="en">X takes place during or as part of Y, and whenever X takes place, Y takes place</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#subevent"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#location">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">location</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the place where the event expressed by a given concept happens.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_location"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#manner_of">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">manner of</rdfs:label>
	<rdfs:comment xml:lang="en">X qualifies the manner in which an action or event expressed by Y takes place</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#in_manner"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#mero_location">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">meronym location</rdfs:label>
	<rdfs:comment xml:lang="en">X is a place located in Y</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#holo_location"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#mero_member">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">meronym member</rdfs:label>
	<rdfs:comment xml:lang="en">Concept A is a member of Concept B</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetの構成員である</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#holo_member"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#mero_part">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">meronym part</rdfs:label>
	<rdfs:comment xml:lang="en">concept A is a component of concept B</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetという部分によって構成される</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#holo_part"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#mero_portion">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">meronym portion</rdfs:label>
	<rdfs:comment xml:lang="en">X is an amount/piece/portion of Y</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#holo_portion"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#mero_substance">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">meronym substance</rdfs:label>
	<rdfs:comment xml:lang="en">Concept A is made of concept B.</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetという物質or材料によって構成される</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#holo_substance"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#meronym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">meronym</rdfs:label>
	<rdfs:comment xml:lang="en">Y makes up a part of X</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetが相手synsetによって構成される</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#holonym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#other">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">other</rdfs:label>
	<rdfs:comment xml:lang="en">Any relation not otherwise specified</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#participle">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">participle</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is a participial adjective derived from a verb expressed by a given concept.</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#patient">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">patient</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the one/that who/which undergoes a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_patient"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#pertainym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">pertainym</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is of or pertaining to a given concept.</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#restricted_by">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">restricted by</rdfs:label>
	<rdfs:comment xml:lang="en">A relation between nominal (pronominal) Y and an adjectival X (quantifier/determiner)</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#restricts"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#restricts">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">restricts</rdfs:label>
	<rdfs:comment xml:lang="en">A relation between an adjectival X (quantifier/determiner) and a nominal (pronominal) Y</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#restricted_by"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#result">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">result</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which comes into existence as a result of a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_result"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#role">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">role</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is involved in the action or event expressed by a given concept.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#similar">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SenseRelType"/>
	<rdfs:label xml:lang="en">similar</rdfs:label>
	<rdfs:comment xml:lang="en">(of words) expressing closely related meanings</rdfs:comment>
	<rdfs:comment xml:lang="ja">当該synsetは表す意味が相手synsetと近似している</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#similar"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#source_direction">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">source direction</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the place from where the event expressed by a given concept begins.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_source_direction"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#state_of">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">state of</rdfs:label>
	<rdfs:comment xml:lang="en">Y is qualified by X</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#be_in_state"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#subevent">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">subevent</rdfs:label>
	<rdfs:comment xml:lang="en">Y takes place during or as part of X, and whenever Y takes place, X takes place</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#is_subevent_of"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#target_direction">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">target direction</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is the place where the action or event expressed by a given concept leads to.</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#involved_target_direction"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#feminine">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">feminine form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept used to refer to female members of a class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_feminine"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_feminine">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">has feminine form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which has a special concept for female members of its class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#feminine"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#masculine">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">masculine form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept used to refer to male members of a class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_masculine"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_masculine">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">has masculine form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which has a special concept for male members of its class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#masculine"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#young">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">young form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept used to refer to young members of a class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_young"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_young">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">has young form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which has a special concept for young members of its class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#young"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#diminutive">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">diminutive</rdfs:label>
	<rdfs:comment xml:lang="en">A concept used to refer to generally smaller members of a class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_diminutive"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_diminutive">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">has diminutive form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which has a special concept for generally smaller members of its class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#diminutive"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#augmentative">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">augmentative</rdfs:label>
	<rdfs:comment xml:lang="en">A concept used to refer to generally larger members of a class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#has_augmentative"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#has_augmentative">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">has augmentative form</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which has a special concept for generally larger members of its class</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#augmentative"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#anto_gradable">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">gradable antonym</rdfs:label>
	<rdfs:comment xml:lang="en">word pairs whose meanings are opposite and which lie on a continuous spectrum</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#anto_gradable"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#anto_simple">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">simple antonym</rdfs:label>
	<rdfs:comment xml:lang="en">word pairs whose meanings are opposite but whose meanings do not lie on a continuous spectrum</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#anto_simple"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#anto_converse">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">converse antonym</rdfs:label>
	<rdfs:comment xml:lang="en">word pairs that name or describe a single relationship from opposite perspectives</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#anto_converse"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#ir_synonym">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">inter-registry synonym</rdfs:label>
	<rdfs:comment xml:lang="en">A concept that means the same except for the style or connotation</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#ir_synonym"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#simple_aspect_ip">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">simple aspect (imperfect to perfect)</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is linked to another through a change from imperfective to perfective aspect</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#simple_aspect_pi"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#secondary_aspect_ip">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">secondary aspect (imperfect to perfect)</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is linked to another through a change in aspect (ip)</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#secondary_aspect_pi"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#simple_aspect_pi">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">simple aspect (perfect to imperfect)</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is linked to another through a change from perfective to imperfective aspect</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#simple_aspect_ip"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#secondary_aspect_pi">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">secondary aspect (perfect to imperfect)</rdfs:label>
	<rdfs:comment xml:lang="en">A concept which is linked to another through a change in aspect (pi)</rdfs:comment>
	<owl:inverseOf rdf:resource="https://globalwordnet.github.io/schemas/wn#secondary_aspect_ip"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#material">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">material</rdfs:label>
	<rdfs:comment xml:lang="en">A word which is typically the material of a given word (e.g. "wood")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#event">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">event</rdfs:label>
	<rdfs:comment xml:lang="en">An noun representing the event of a verb (e.g., "(a) meet" - "(to) meet")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#instrument">
	<rdfs:comment xml:lang="en">An instrument for doing a task (e.g., "photocopier" - "photocopy")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#location">
	<rdfs:comment xml:lang="en">A verb derived from the action performed at a place (e.g., "(a) forge" - "(to) forge")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#by_means_of">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">by means of</rdfs:label>
	<rdfs:comment xml:lang="en">A word which is typically the means by which something is done (e.g.,g "deceive" - "deception")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#undergoer">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">undergoer</rdfs:label>
	<rdfs:comment xml:lang="en">A word which is typically the undergoer of a given word (e.g. "honor" - "honoree")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#property">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">property</rdfs:label>
	<rdfs:comment xml:lang="en">Cause something to have a particular property (e.g., "magnetize" - "magnetization")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#result">
	<rdfs:comment xml:lang="en">A word which is typically the result of a given word (e.g. "nitrify" - "nitrate")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#state">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">state</rdfs:label>
	<rdfs:comment xml:lang="en">A state caused by the verb (e.g., "sensitize" - "sensitization")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#uses">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">uses</rdfs:label>
	<rdfs:comment xml:lang="en">A verb that uses a noun (e.g., "(to) talc" - "talc")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#destination">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">destination</rdfs:label>
	<rdfs:comment xml:lang="en">The noun indicates the destination of a verb (e.g., "retire" - "retiree")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#body_part">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">body part</rdfs:label>
	<rdfs:comment xml:lang="en">A word which is typically a body part of a given word (e.g. "finger")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#vehicle">
	<rdf:type rdf:resource="https://globalwordnet.github.io/schemas/wn#SynsetRelType"/>
	<rdfs:label xml:lang="en">vehicle</rdfs:label>
	<rdfs:comment xml:lang="en">A verb indicating movement with a particular vehicle (e.g., "(to) ship" - "ship")</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#senseSubcat">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:label xml:lang="en">sense subcategorization</rdfs:label>
	<rdfs:comment xml:lang="en">Indicates that a syntactic behaviour applies to a specific sense</rdfs:comment>
	<rdfs:range rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalSense"/>
	<rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/synsem#SyntacticBehaviour"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#ili">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:label xml:lang="en">interlingual index</rdfs:label>
	<rdfs:comment xml:lang="en">links a synset to a target the Interlingual Index</rdfs:comment>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#exactMatch"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#memberList">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment xml:lang="en">The list of words in a synset in order</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#lexfile">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">lexicographer file</rdfs:label>
	<rdfs:comment xml:lang="en">Indicates the lexicographer file that this synset is derived from</rdfs:comment>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#Pronunciation">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:label xml:lang="en">pronunciation</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#pronunciation">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:label xml:lang="en">pronunciation</rdfs:label>
	<rdfs:comment xml:lang="en">Indicates the pronunciation of a form</rdfs:comment>
	<rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#Form"/>
	<rdfs:range rdf:resource="https://globalwordnet.github.io/schemas/wn#Pronunciation"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#variety">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">variety</rdfs:label>
	<rdfs:comment xml:lang="en">Indicates the variety of language the pronunciation represents</rdfs:comment>
	<rdfs:domain rdf:resource="https://globalwordnet.github.io/schemas/wn#Pronunciation"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#notation">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">notation</rdfs:label>
	<rdfs:comment xml:lang="en">The notation scheme used for a pronunciation</rdfs:comment>
	<rdfs:domain rdf:resource="https://globalwordnet.github.io/schemas/wn#Pronunciation"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#phonemic">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">phonemic</rdfs:label>
	<rdfs:comment xml:lang="en">Indicates if the pronunciation is phonemic, in that it does not represent every aspect of the pronunciation and omits information that could be assumed for this language</rdfs:comment>
	<rdfs:domain rdf:resource="https://globalwordnet.github.io/schemas/wn#Pronunciation"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#audio">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">audio</rdfs:label>
	<rdfs:comment xml:lang="en">Links to an audio file for a pronunciation</rdfs:comment>
	<rdfs:domain rdf:resource="https://globalwordnet.github.io/schemas/wn#Pronunciation"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#index">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">index</rdfs:label>
	<rdfs:comment xml:lang="en">The normalized form of a lexical entry for indexing purposes</rdfs:comment>
	<rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalEntry"/>
	<rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
</rdf:Description>

<rdf:Description rdf:about="https://globalwordnet.github.io/schemas/wn#n">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:label xml:lang="en">n</rdfs:label>
	<rdfs:comment xml:lang="en">The ordering of a sense within a lexical entry or a normalized group of entries</rdfs:comment>
	<rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalSense"/>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</rdf:Description>

</rdf:RDF>