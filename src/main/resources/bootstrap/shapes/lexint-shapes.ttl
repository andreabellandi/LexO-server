@prefix lexint: <https://lexo.ilc.cnr.it/vocabulary/lexical-interpretation#> .
@prefix shapes: <https://lexo.ilc.cnr.it/vocabulary/lexical-interpretation/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix crminf: <http://www.cidoc-crm.org/extensions/crminf/> .

<https://lexo.ilc.cnr.it/vocabulary/lexical-interpretation/shapes>
    a owl:Ontology ;
    dcterms:title "LexInt: SHACL Validation Shapes"@en ;
    dcterms:description "SHACL constraints for the LexInt Lexicographic Interpretation Profile."@en .

shapes:ClaimShape a sh:NodeShape ;
    sh:targetClass lexint:InterpretiveClaim ;
    sh:property [ sh:path lexint:targetAssertion ; sh:minCount 1 ;
                  sh:class lexint:TargetAssertion ] ;
    # A claim must have a description in at least one of the two supported
    # forms. Both may coexist (unlike the mutually exclusive candidate forms).
    sh:or (
      [ sh:property [ sh:path dcterms:description ; sh:minCount 1 ] ]
      [ sh:property [ sh:path crminf:J26_has_unambiguous_description ;
                      sh:minCount 1 ] ]
    ) .

shapes:CandidateShape a sh:NodeShape ;
    sh:targetClass lexint:TargetAssertion ;
    # Exactly one COMPLETE representation is allowed. Any property belonging
    # to the other reification form is forbidden, even if that other form
    # would be incomplete.
    sh:xone (
      # RDF 1.2: precisely one rdf:reifies and no RDF 1.1 statement fields.
      [ sh:property [ sh:path rdf:reifies ; sh:minCount 1 ; sh:maxCount 1 ] ;
        sh:property [ sh:path rdf:subject ; sh:maxCount 0 ] ;
        sh:property [ sh:path rdf:predicate ; sh:maxCount 0 ] ;
        sh:property [ sh:path rdf:object ; sh:maxCount 0 ] ]
      # RDF 1.1: complete classic reification, no rdf:reifies.
      [ sh:property [ sh:path rdf:subject ; sh:minCount 1 ; sh:maxCount 1 ;
                      sh:nodeKind sh:BlankNodeOrIRI ] ;
        sh:property [ sh:path rdf:predicate ; sh:minCount 1 ; sh:maxCount 1 ;
                      sh:nodeKind sh:IRI ] ;
        sh:property [ sh:path rdf:object ; sh:minCount 1 ; sh:maxCount 1 ] ;
        sh:property [ sh:path rdf:reifies ; sh:maxCount 0 ] ]
    ) .

shapes:DecisionShape a sh:NodeShape ;
    sh:targetClass lexint:LexicographicDecision ;
    sh:property [ sh:path lexint:concernsClaim ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class lexint:InterpretiveClaim ] ;
    sh:property [ sh:path lexint:decisionOutcome ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in (lexint:adopted lexint:rejected lexint:suspended lexint:replaced) ] ;
    sh:property [ sh:path lexint:appliesToVersion ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class prov:Entity ] ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:class prov:Agent ] ;
    sh:property [ sh:path dcterms:description ; sh:minCount 1 ] .

# The graph-publication invariant (accepted vs materialized triples)
# cannot be enforced by these structural shapes alone. See README and QA.
